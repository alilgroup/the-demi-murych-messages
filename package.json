{
  "name": "the-demi-murych-messages",
  "version": "1.0.0",
  "description": "CLI-приложение на Node.js 22 для фильтрации сообщений и классификации их с помощью LLM (Groq).",
  "type": "module",
  "main": "app.mjs",
  "scripts": {
    "start": "node app.mjs",
    "start:demo": "node app.mjs --from=result.json --to=demi_messages.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "groq-sdk": "^0.37.0",
    "stream-json": "^1.8.0"
  }
}
